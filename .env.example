# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Everything here is OPTIONAL — Sentinel computes its risk score without an LLM.
# These variables only enable the plain-English explanation (Phase 4).

# API key from https://build.nvidia.com — starts with `nvapi-`
NVIDIA_API_KEY=

# Any model from the NVIDIA catalog, e.g. openai/gpt-oss-120b
SENTINEL_LLM_MODEL=meta/llama-3.3-70b-instruct
